# Scoopy Doo Mission Control - Environment Configuration

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=4173
NODE_ENV=development

# ===================================
# GOOGLE APIS
# ===================================
# Get these from Google Cloud Console
# https://console.cloud.google.com

# Google Ads API
GOOGLE_ADS_API_KEY=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Google Business Profile API
GOOGLE_BUSINESS_PROFILE_KEY=

# Google Analytics
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_KEY=

# Google Search Console
GOOGLE_SEARCH_CONSOLE_KEY=

# ===================================
# FACEBOOK ADS API
# ===================================
# Get these from Facebook Business Manager
# https://business.facebook.com/

FACEBOOK_BUSINESS_ACCOUNT_ID=1460840901718573
FACEBOOK_AD_ACCOUNT_ID=120243479982690024
FACEBOOK_ACCESS_TOKEN=EAAYAAhMwFDkBRY1UwI06NR6J3QyXIEiowvsHdlKwJCD1LWsBNKLqAyJFmUYRPmhxo9A5xBcbONN3SezUuxdhT8BZCag1YywV7tTNVwBxY9SjIUNKCUZB1xOyp3gkrwB8cOscC4NSC3kMcHgajN5SL4a7TbmowTcMjH7Sbq6MWsjzUajj70lR1DH2JG4QZDZD

# ===================================
# JOBBER API
# ===================================
# Get these from Jobber
# https://getjobber.com/

JOBBER_API_KEY=
JOBBER_API_SECRET=
JOBBER_ACCOUNT_ID=

# ===================================
# OPENCLAW INTEGRATION
# ===================================
# Openclaw agent monitoring and control

OPENCLAW_API_URL=http://localhost:8080
OPENCLAW_API_KEY=

# ===================================
# DATABASE CONFIGURATION (Optional)
# ===================================
# If you want to persist cached data

DATABASE_URL=
DB_TYPE=sqlite
DB_FILE=./data/mission-control.db

# ===================================
# API CONFIGURATION
# ===================================
# CORS settings
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache settings
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE_MB=100

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=info
LOG_FORMAT=json

# ===================================
# FEATURES & FLAGS
# ===================================
# Enable/disable features

ENABLE_MOCK_DATA=true
ENABLE_FACEBOOK_SYNC=true
ENABLE_GOOGLE_SYNC=true
ENABLE_JOBBER_SYNC=false
ENABLE_AGENT_MONITORING=true

# ===================================
# SYNC INTERVALS (in seconds)
# ===================================

SYNC_INTERVAL_AGENTS=60
SYNC_INTERVAL_ADS=300
SYNC_INTERVAL_LEADS=600
SYNC_INTERVAL_JOBBER=900

# ===================================
# ALERTS & THRESHOLDS
# ===================================

# Agent health alert threshold (0-100)
AGENT_HEALTH_ALERT_THRESHOLD=60

# Cost per lead alert threshold ($)
CPL_ALERT_THRESHOLD=50

# Queue size alert threshold
QUEUE_SIZE_ALERT_THRESHOLD=50

# Lead response time alert threshold (minutes)
LEAD_RESPONSE_TIME_THRESHOLD=120

# ===================================
# BUSINESS SETTINGS
# ===================================

# Business name
BUSINESS_NAME=Scoopy Doo LLC

# Primary service area
PRIMARY_SERVICE_AREA=Chattanooga

# Currency
CURRENCY=USD

# Timezone
TIMEZONE=America/Chicago

# ===================================
# SECURITY (IMPORTANT)
# ===================================
# Change these in production!

API_SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# Enable API authentication
REQUIRE_AUTH=false
AUTH_TYPE=api_key

# ===================================
# MONITORING & ANALYTICS
# ===================================

# Sentry error tracking (optional)
SENTRY_DSN=

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_ENDPOINT=

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# ===================================
# DEVELOPMENT ONLY
# ===================================

# Debug mode
DEBUG=false

# Enable request logging
LOG_REQUESTS=true

# Mock data realistic? (if true, matches real business metrics)
MOCK_DATA_REALISTIC=true

# Auto-reload on file change
AUTO_RELOAD=true
